{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    // Type-checking this package also checks the engine and element sources it imports, which
    // are written for unchecked indexing (see packages/engine/tsconfig.json).
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "e2e"]
}
